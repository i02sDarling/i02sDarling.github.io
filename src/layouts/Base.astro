---
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = '妲零的个人博客：记录在做的事、学到的东西，以及还没想清楚的念头。',
} = Astro.props

const nav = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '/skills/', label: '工具' },
]
const current = Astro.url.pathname
const siteTitle = title === '妲零' ? '妲零' : `${title} · 妲零`
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6d28d9" />
    <meta property="og:site_name" content="妲零" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="logo" href="/">
          <span class="logo-mark">妲</span>
          <span class="logo-text">妲零</span>
        </a>
        <nav>
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.href }]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} 妲零 · Darling</p>
        <p class="muted">个人博客，内容仅为个人记录与分享。</p>
      </div>
    </footer>
  </body>
</html>
