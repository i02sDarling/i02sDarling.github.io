        tip: '198% ≈ 200%，倒数 0.5。差 2% 不影响判断',
      },
      {
        n: 0.36,
        pct: 275,
        g: 'big',
        tip: '275% = 11/4，倒数 4/11 ≈ 0.36。涨 275% = 3.75 倍',
      },
      {
        n: 0.29,
        pct: 350,
        g: 'big',
        tip: '350% = 7/2，倒数 2/7 ≈ 0.29。就是 28.6% 这条的倒数',
      },
      {
        n: 0.22,
        pct: 450,
        g: 'big',
        tip: '450% = 9/2，倒数 2/9 ≈ 0.22。就是 22.2% 这条的倒数',
      },
      {
        n: 0.14,
        pct: 700,
        g: 'big',
        tip: '700% = 7 倍，倒数 <b>1/7 ≈ 0.14</b>。涨 700% = 8 倍',
      },
      {
        n: 0.11,
        pct: 900,
        g: 'big',
        tip: '900% = 9 倍，倒数 <b>1/9 ≈ 0.11</b>。涨 900% = 10 倍',
      },
    ]

    /* =========================================================
       简单难度题库：基础表（1/n，n=2..10）的 k 倍，写成 k/n
       只列约分后分子不再是 1 的，避免与基础表撞车（2/4 就是 1/2）
       ========================================================= */
    const MULTD = [
      { k: 2, n: 3, pct: 66.7, tip: '33.3% 的两倍，也就是 1/1.5。看到 66.7 先想 2/3' },
      { k: 3, n: 4, pct: 75, tip: '25% 的三倍；和 1/4 差 25%，凑整就是 3/4' },
      { k: 2, n: 5, pct: 40, tip: '20% 的两倍；记住 2/5 = 40% 比记 1/2.5 快' },
      { k: 3, n: 5, pct: 60, tip: '20% 的三倍；也就是 3/5，和 2/5 差 20%' },
      { k: 4, n: 5, pct: 80, tip: '20% 的四倍；离 100% 只差 1/5' },
      { k: 5, n: 6, pct: 83.3, tip: '16.7% 的五倍；离 100% 只差 1/6' },
      { k: 2, n: 7, pct: 28.6, tip: '14.3% 的两倍；7 的倍数：14.3 / 28.6 / 42.9 / 57.1 / 71.4 / 85.7' },
      { k: 3, n: 7, pct: 42.9, tip: '14.3% 的三倍；7 的倍数第三个' },
      { k: 4, n: 7, pct: 57.1, tip: '14.3% 的四倍；4/7 的倒数就是 1.75' },
      { k: 5, n: 7, pct: 71.4, tip: '14.3% 的五倍；和 1/1.4 是一回事' },
      { k: 6, n: 7, pct: 85.7, tip: '14.3% 的六倍；离 100% 只差 1/7' },
      { k: 3, n: 8, pct: 37.5, tip: '12.5% 的三倍；3/8 比 1/2.67 好记，考试直接报分母 8' },
      { k: 5, n: 8, pct: 62.5, tip: '12.5% 的五倍；也是 1/1.6，看你怎么顺口' },
      { k: 7, n: 8, pct: 87.5, tip: '12.5% 的七倍；离 100% 只差 1/8' },
      { k: 2, n: 9, pct: 22.2, tip: '11.1% 的两倍；2/9 的倒数是 4.5' },
      { k: 4, n: 9, pct: 44.4, tip: '11.1% 的四倍；4/9 的倒数是 2.25' },
      { k: 5, n: 9, pct: 55.6, tip: '11.1% 的五倍；5/9 的倒数是 1.8' },
      { k: 7, n: 9, pct: 77.8, tip: '11.1% 的七倍；查表时别和 7/8 = 87.5% 混了' },
      { k: 8, n: 9, pct: 88.9, tip: '11.1% 的八倍；离 100% 只差 1/9' },
      { k: 3, n: 10, pct: 30, tip: '10% 的三倍；3/10 是最省事的一批' },
      { k: 7, n: 10, pct: 70, tip: '10% 的七倍；离 100% 差 30%' },
      { k: 9, n: 10, pct: 90, tip: '10% 的九倍；离 100% 只差 10%' },
    ]

    /* =========================================================
       反向估算题库：[基准分母, 基准百分数, 题面百分数]
       ========================================================= */
    const EST = [
      [7, 14.3, 14.5], [7, 14.3, 14.1], [7, 14.3, 14.6], [7, 14.3, 14.0],
      [6, 16.7, 16.5], [6, 16.7, 16.9], [6, 16.7, 16.4], [6, 16.7, 17.0],
      [8, 12.5, 12.7], [8, 12.5, 12.3], [8, 12.5, 12.8],
      [9, 11.1, 11.3], [9, 11.1, 10.9], [9, 11.1, 11.4],
      [11, 9.1, 9.2], [11, 9.1, 9.0], [11, 9.1, 9.3],
      [12, 8.3, 8.5], [12, 8.3, 8.2], [12, 8.3, 8.6],
      [13, 7.7, 7.8], [13, 7.7, 7.6],
      [15, 6.7, 6.9], [15, 6.7, 6.5],
      [17, 5.9, 6.1], [17, 5.9, 5.8],
      [19, 5.3, 5.4], [19, 5.3, 5.2],
      [4, 25, 25.3], [4, 25, 24.8],
      [5, 20, 20.2], [5, 20, 19.8],
      [3, 33.3, 33.6], [3, 33.3, 33.0],
      [10, 10, 10.1], [10, 10, 9.9],
    ].map((a) => ({ n: a[0], basePct: a[1], pct: a[2] }))

    /* 给每条题目标号：点历史记录重做原题时用 */
    DATA.forEach((d, i) => { d._i = i })
    EST.forEach((d, i) => { d._e = i })
    MULTD.forEach((d, i) => { d._m = i })

    /* 简单难度的出题池：基础 1/2–1/10 + 进阶 1/11–1/15 + 高阶 1/16–1/20，再加倍数 */
    const EASY_GROUPS = { basic: true, mid: true, high: true }
    const EASY_POOL = DATA.filter((d) => EASY_GROUPS[d.g] && d.real === undefined).concat(MULTD)
    /* 简单难度的估算题只用 3–20 的基准（正好覆盖表里三段） */
    const EST_EASY = EST.filter((d) => d.n <= 20)

    const MONEY = [1000, 1200, 1500, 1800, 2000, 2500, 3000, 345, 420, 560, 860, 1250, 1600, 2400]

    const r2 = (v) => Math.round(v * 100) / 100
    const randOf = (a) => a[Math.floor(Math.random() * a.length)]
    // 有些题面是近似值（249% ≈ 250%），反向题要用精确值 250
    const pctOf = (e) => (e.real === undefined ? e.pct : e.real)
    /* 分数写法：1/n 或 k/n */
    const fracOf = (e) => (e.k ? e.k + '/' + e.n : '1/' + e.n)
    /* 增长量的除数 = 1 + 1/r = 1 + n/k */
    const divisor = (e) => 1 + e.n / (e.k || 1)

    const state = {
      groups: { basic: true, mid: true, high: true, dec: true, big: true },
      level: 1,
      mode: 'fwd',
      total: 0, right: 0, streak: 0, best: 0, timeSum: 0,
      wrongs: [], bag: [], last: null, recent: [],
      history: [],
      q: null, phase: 'ask', t0: 0, autoNext: 0, replay: false,
    }

    const $ = (id) => document.getElementById(id)
    let qseq = 0

    /* ---------------- 抽题：洗牌袋，一轮内不重复 ---------------- */
    function pool() {
      // 简单：固定为基础表 + 倍数，不受「范围」影响
      if (state.level === 0) return EASY_POOL
      const avail = (d) => (d.lv || 1) <= state.level
      let p = DATA.filter((d) => state.groups[d.g] && avail(d))
      if (!p.length) p = DATA.filter(avail)
      if (!p.length) p = DATA
      return p
    }

    function shuffleInPlace(a) {
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1))
        const t = a[i]
        a[i] = a[j]
        a[j] = t
      }
      return a
    }

    function drawBag() {
      const p = pool()
      // 范围被用户改过：把袋子里已经不在范围内的清掉
      state.bag = state.bag.filter((d) => p.indexOf(d) >= 0)

      if (!state.bag.length) {
        state.bag = shuffleInPlace(p.slice())
        // 把上一题挪到袋底：本轮最后才轮到它，保证新的一轮不会开口就重
        const i = state.last ? state.bag.indexOf(state.last) : -1
        if (i > 0) {
          const x = state.bag.splice(i, 1)[0]
          state.bag.unshift(x)
        }
      }
      return state.bag.pop()
    }

    function pickEntry() {
      const p = pool()
      // 错题优先：但排除刚出过的那题，比例也从 35% 降到 25%
      const weak = state.wrongs.filter((d) => p.indexOf(d) >= 0 && state.recent.indexOf(d) < 0)
      if (weak.length && Math.random() < 0.25) {
        const e = randOf(weak)
        // 从袋子里摘掉，保证同一轮里不会又抽回它
        const bi = state.bag.indexOf(e)
        if (bi >= 0) state.bag.splice(bi, 1)
        return e
      }
      return drawBag()
    }

    /* ---------------- 答题记录：缓存到 localStorage ---------------- */
    const HKEY = 'bhf_history_v1'
    const TYPE_LABEL = { fwd: '正向', rev: '分母', growth: '增长量', est: '估算' }
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')

    function loadHistory() {
      try {
        const raw = localStorage.getItem(HKEY)
        const arr = raw ? JSON.parse(raw) : []
        return Array.isArray(arr) ? arr : []
      } catch (e) {
        return []
      }
    }

    function saveHistory() {
      try {
        localStorage.setItem(HKEY, JSON.stringify(state.history.slice(0, 100)))
      } catch (e) {}
    }

    function fmtTime(ts) {
      const d = new Date(ts)
      const p = (x) => (x < 10 ? '0' + x : '' + x)
      return p(d.getHours()) + ':' + p(d.getMinutes())
    }

    function qBrief(q) {
      if (q.type === 'fwd') return q.e.pct + '% → ' + (q.e.k ? q.e.k + '/?' : '1/?')
      if (q.type === 'rev') return fracOf(q.e) + ' → ?%'
      if (q.type === 'growth') return '现期 ' + q.money + ' · 增 ' + q.e.pct + '% → ÷?'
      return q.pct + '% 对比 1/' + q.e.n + ' 基准'
    }

    function recordRow(it, i) {
      const can = it.di != null || it.ei != null || it.mi != null
      return (
        '<div class="hrow ' + (it.ok ? 'ok' : 'bad') + (can ? ' canredo' : '') + '"' +
        (can ? ' data-i="' + i + '" title="点一下重做这道题"' : '') + '>' +
        '<span class="tag">' + (TYPE_LABEL[it.type] || it.type) + '</span>' +
        '<span class="qt">' + esc(it.brief) + '</span>' +
        '<span class="tm">' + fmtTime(it.ts) + '</span>' +
        '<span class="mark">' + (it.ok ? '✓' : '✗') + '</span>' +
        '<span class="an">你 ' + esc(it.your) + '　应 <b>' + esc(it.correct) + '</b></span>' +
        '</div>'
      )
    }

    function renderHistory() {
      const list = $('histList')
      if (!state.history.length) {
        list.innerHTML = '<div class="hempty">还没有记录，答完第一题就会出现在这里。</div>'
        $('hCount').textContent = '0 条'
        return
      }
      $('hCount').textContent = state.history.length + ' 条'
      list.innerHTML = state.history.slice(0, 40).map(recordRow).join('')
    }

    /* ---------------- 点历史记录 → 回到那一题 ---------------- */
    function replayHistory(i) {
      const it = state.history[i]
      if (!it) return
      let q = null
      if (it.ei != null && EST[it.ei]) {
        const e = EST[it.ei]
        q = { type: 'est', e: e, pct: e.pct }
      } else if (it.mi != null && MULTD[it.mi]) {
        const e = MULTD[it.mi]
        q = { type: it.type, e: e, money: it.money || randOf(MONEY), replay: true }
      } else if (it.di != null && DATA[it.di]) {
        const e = DATA[it.di]
        q = { type: it.type, e: e, money: it.money || randOf(MONEY), replay: true }
      }
      if (!q) return

      clearTimeout(state.autoNext)
      state.phase = 'ask'
      state.q = q
      state.replay = true
      renderQuestion()
      updateBtn()

      const top = $('card').getBoundingClientRect().top + window.pageYOffset - 10
      try {
        window.scrollTo({ top: top, behavior: 'smooth' })
      } catch (e) {
        window.scrollTo(0, top)
      }
    }

    function pushHistory(q, ok, your, dt) {
      state.history.unshift({
        ts: Date.now(),
        type: q.type,
        brief: qBrief(q),
        your: String(your),
        correct: answerText(q),
        ok: ok,
        ms: Math.round(dt),
        di: q.e && q.e._i !== undefined ? q.e._i : null,
        ei: q.e && q.e._e !== undefined ? q.e._e : null,
        mi: q.e && q.e._m !== undefined ? q.e._m : null,
        money: q.money || 0,
      })
      if (state.history.length > 100) state.history.length = 100
      saveHistory()
      renderHistory()
    }

    function buildQuestion() {
      let type = state.mode
      if (type === 'mixed') type = randOf(['fwd', 'rev', 'growth'])

      if (type === 'est') {
        const e = randOf(state.level === 0 ? EST_EASY : EST)
        return { type: 'est', e: e, pct: e.pct }
      }
      const e = pickEntry()
      return { type: type, e: e, money: type === 'growth' ? randOf(MONEY) : 0 }
    }

    /* ---------------- 渲染 ---------------- */
    function inputHtml(ph) {
      return (
        '<input id="ans" type="text" inputmode="none" autocomplete="off" spellcheck="false" placeholder="' +
        ph +
        '">'
      )
    }

    function hasFinePointer() {
      try {
        return window.matchMedia && matchMedia('(pointer:fine)').matches
      } catch (e) {
        return false
      }
    }

    function renderQuestion() {
      const q = state.q, e = q.e
      $('card').className = 'card'
      $('fb').className = 'fb'
      $('fb').innerHTML = ''

      if (q.type === 'fwd') {
        $('qtype').textContent = '百 分 数 → 分 母'
        $('q').textContent = e.pct + '%'
        $('sub').innerHTML = '≈ ' + (e.k || 1) + ' / ' + inputHtml('?')
      } else if (q.type === 'rev') {
        $('qtype').textContent = '分 母 → 百 分 数'
        $('q').textContent = fracOf(e)
        $('sub').innerHTML = '≈ ' + inputHtml('?') + ' %'
      } else if (q.type === 'growth') {
        $('qtype').textContent = '增 长 量 · 现 期 ÷ (1 + 1/r)'
        $('q').textContent = e.pct + '%'
        $('sub').innerHTML =
          '<span class="small">现期 ' + q.money + ' 的增长量 = ' + q.money + ' ÷</span>' + inputHtml('除数')
      } else {
        $('qtype').textContent = '反 向 估 算 · 判 方 向'
        $('q').textContent = e.pct + '%'
        $('sub').innerHTML =
          '<span class="small baseline">基准　1/' + e.n + ' = ' + e.basePct + '%</span>' +
          '<div class="optrow">' +
          '<button class="opt" type="button" data-v="-1">' + e.n + ' 不到分之 1<span class="kbd">按 1</span></button>' +
          '<button class="opt" type="button" data-v="1">' + e.n + ' 加分之 1<span class="kbd">按 2</span></button>' +
          '</div>'
        const opts = $('sub').querySelectorAll('.opt')
        for (let i = 0; i < opts.length; i++) {
          opts[i].addEventListener('click', function () {
            pickEst(parseInt(this.dataset.v, 10))
          })
        }
      }

      const inp = $('ans')
      if (inp) {
        inp.value = ''
        inp.disabled = false
        // 桌面端自动聚焦方便物理键盘；触屏端不聚焦，避免弹系统键盘
        if (hasFinePointer()) inp.focus()
      }
      $('numRow').hidden = q.type === 'est'
      $('numRow').classList.remove('off')
      if (state.replay) {
        $('qtype').textContent += ' · 历史重做'
        state.replay = false
      }
      state.t0 = performance.now()
    }

    function nextQuestion() {
      clearTimeout(state.autoNext)
      state.replay = false
      state.phase = 'ask'
      state.q = buildQuestion()
      state.last = state.q.e
      state.recent.unshift(state.q.e)
      if (state.recent.length > 3) state.recent.pop()
      qseq++
      renderQuestion()
      updateBtn()
    }

    function updateBtn() {
      $('btnGo').textContent = state.phase === 'ask' ? '提交 (Enter)' : '下一题 (Enter)'
    }

    /* ---------------- 判定 ----------------
       分母题：与「表里的 n」或「100 ÷ 百分数」相差 < 0.01 才算对
       （两条都认，是因为 53% 这种表里取 1.9、精确值其实是 1.887）
       ------------------------------------------------------- */
    function expN(e) {
      return 100 / pctOf(e)
    }

    function judge(v, q) {
      if (q.type === 'fwd') {
        return Math.abs(v - q.e.n) < 0.01 || Math.abs(v - expN(q.e)) < 0.01
      }
      if (q.type === 'rev') {
        const p = pctOf(q.e)
        return Math.abs(v - p) <= Math.max(0.2, p * 0.02)
      }
      const t = divisor(q.e), te = expN(q.e) + 1
      return Math.abs(v - t) < 0.01 || Math.abs(v - te) < 0.01
    }

    function answerText(q) {
      if (q.type === 'fwd') return fracOf(q.e)
      if (q.type === 'rev') return pctOf(q.e) + '%'
      if (q.type === 'est') {
        return q.e.n + (q.pct > q.e.basePct ? ' 不到分之 1' : ' 加分之 1')
      }
      return '÷ ' + r2(divisor(q.e)) + '　→　增长量 ≈ ' + Math.round(q.money / r2(divisor(q.e)))
    }

    /* 答错时把你写的值和标准值差多少摆出来，避免「好像差不多」的错觉 */
    function diffNote(q, your) {
      if (q.type !== 'fwd') return ''
      const v = parseFloat(your)
      if (!isFinite(v)) return ''
      const d = Math.abs(v - q.e.n)
      if (d <= 0.01) return ''
      return (
        '<div class="near">你写 ' + esc(your) + '，与标准值 ' + q.e.n +
        ' 相差 ' + Math.round(d * 1000) / 1000 + '，超过 0.01 判错。</div>'
      )
    }

    function tipText(q) {
      if (q.type === 'growth') {
        const d = r2(divisor(q.e))
        return (
          '增长率 <em>' + q.e.pct + '%</em> = <em>' + fracOf(q.e) +
          '</em>，所以增长量 = 现期 ÷ (1 + 1/r) = 现期 ÷ <em>' + d + '</em>。<br>' +
          '例：' + q.money + ' 增 ' + q.e.pct + '% → ' + q.money + ' ÷ ' + d + ' ≈ ' +
          Math.round(q.money / d) + '。'
        )
      }
      if (q.type === 'est') {
        const up = q.pct > q.e.basePct
        const real = 100 / q.pct
        const err = (Math.abs(real - q.e.n) / q.e.n) * 100
        return (
          '题面 <b>' + q.pct + '%</b>，比基准 ' + q.e.basePct + '% ' + (up ? '大' : '小') +
          ' → 分数值' + (up ? '变大' : '变小') + ' → 分母要' + (up ? '变小' : '变大') +
          '，所以是「<em>' + q.e.n + (up ? ' 不到' : ' 加') + '分之 1</em>」。<br>' +
          '精确算：1 ÷ ' + q.pct + '% ≈ <em>' + real.toFixed(1) + '</em>，只比 ' + q.e.n + ' ' +
          (up ? '小' : '大') + '约 ' + err.toFixed(1) + '%，考试里不用算，方向对就够选。'
        )
      }
      return q.e.tip
    }

    /* ---------------- 结算 ---------------- */
    function finish(ok, q, keepOnRight, your) {
      const dt = performance.now() - state.t0
      state.total++
      state.timeSum += dt

      pushHistory(q, ok, your === undefined ? '—' : your, dt)

      if (ok) {
        state.right++
        state.streak++
        if (state.streak > state.best) state.best = state.streak
        // 已经答对，从错题池里摘掉，不再反复重出
        const wi = state.wrongs.indexOf(q.e)
        if (wi >= 0) state.wrongs.splice(wi, 1)
        $('card').className = 'card ok'
        $('fb').innerHTML =
          '<span class="ok">✓ ' + answerText(q) + '</span>' +
          (keepOnRight ? '<div class="tip">' + tipText(q) + '</div>' : '')
        state.phase = 'fb'
        $('numRow').classList.add('off')
        updateBtn()
        updateStats()
        const my = qseq
        if (!keepOnRight) {
          clearTimeout(state.autoNext)
          state.autoNext = setTimeout(function () {
            if (qseq === my && state.phase === 'fb') nextQuestion()
          }, 520)
        }
      } else {
        state.streak = 0
        if (state.wrongs.indexOf(q.e) < 0) state.wrongs.push(q.e)
        if (state.wrongs.length > 12) state.wrongs.shift()
        $('card').className = 'card bad'
        $('fb').innerHTML =
          '<span class="bad">✗ 正确答案：' + answerText(q) + '</span>' +
          diffNote(q, your) +
          '<div class="tip">' + tipText(q) + '</div>'
        state.phase = 'fb'
        $('numRow').classList.add('off')
        updateBtn()
        updateStats()
      }
    }

    /* ---------------- 提交 ---------------- */
    function submit() {
      if (state.phase === 'fb') {
        nextQuestion()
        return
      }
      if (state.q.type === 'est') return

      const inp = $('ans')
      const raw = inp.value.trim().replace(/[,，。]/g, '.')
      if (raw === '') {
        nudge(inp)
        return
      }
      const v = parseFloat(raw)
      if (!isFinite(v)) {
        nudge(inp)
        return
      }

      finish(judge(v, state.q), state.q, false, raw)
    }

    function pickEst(dir) {
      if (state.phase !== 'ask' || !state.q || state.q.type !== 'est') return
      const q = state.q
      const correct = q.pct > q.e.basePct ? -1 : 1

      const opts = $('sub').querySelectorAll('.opt')
      for (let i = 0; i < opts.length; i++) {
        const v = parseInt(opts[i].dataset.v, 10)
        if (v === correct) opts[i].classList.add('right')
        else if (v === dir) opts[i].classList.add('wrong')
        opts[i].disabled = true
      }
      finish(dir === correct, q, true, q.e.n + (dir === -1 ? ' 不到分之 1' : ' 加分之 1'))
    }

    function nudge(inp) {
      inp.classList.add('nudge')
      setTimeout(function () {
        inp.classList.remove('nudge')
      }, 320)
    }

    function updateStats() {
      $('sRight').textContent = state.right + ' / ' + state.total
      $('sStreak').textContent = state.streak + (state.streak >= 5 ? ' 🔥' : '')
      $('sTime').textContent = state.total ? (state.timeSum / state.total / 1000).toFixed(1) + 's' : '—'
    }

    /* ---------------- 交互 ---------------- */
    const modalOpen = () => !$('setModal').hidden || !$('tblModal').hidden

    document.addEventListener(
      'keydown',
      function (e) {
        if (modalOpen()) return
        const el = document.activeElement
        // 别抢站点导航的键盘操作
        if (el && (el.tagName === 'A' || (el.tagName === 'BUTTON' && el.id !== 'btnGo'))) return

        if (state.q && state.q.type === 'est' && state.phase === 'ask') {
          if (e.key === '1') {
            e.preventDefault()
            pickEst(-1)
            return
          }
          if (e.key === '2') {
            e.preventDefault()
            pickEst(1)
            return
          }
        }
        if (e.key === 'Enter') {
          e.preventDefault()
          submit()
        }
      },
      sig,
    )

    $('btnGo').addEventListener('click', submit)

    /* ---------------- 答题小键盘（替代系统键盘） ---------------- */
    $('numRow').addEventListener('click', function (e) {
      const b = e.target.closest('.nk')
      if (!b || state.phase !== 'ask') return
      const inp = $('ans')
      if (!inp || inp.disabled) return
      const k = b.dataset.k
      if (k === 'back') {
        inp.value = inp.value.slice(0, -1)
      } else if (k === '.') {
        if (inp.value.indexOf('.') >= 0) return
        inp.value = inp.value ? inp.value + '.' : '0.'
      } else {
        inp.value += k
      }
      inp.classList.remove('nudge')
      inp.classList.add('active')
    })

    /* ---------------- 计算器结果 → 直接提交为答案 ---------------- */
    $('calcSend').addEventListener('click', function () {
      if (!state.q || state.phase !== 'ask') {
        calcOut.textContent = '先答完当前这题，再算下一题'
        calcOut.classList.add('dim')
        return
      }
      if (state.q.type === 'est') {
        calcOut.textContent = '这道是选择题，直接点选项'
        calcOut.classList.add('dim')
        return
      }
      const src = calcIn.value.trim()
      if (!src) return
      const v = calcEval(src)
      if (!isFinite(v)) {
        calcOut.textContent = '算式看不懂'
        calcOut.classList.add('dim')
        return
      }
      const f = calcFormat(v)
      calcIn.value = f
      calcOut.textContent = '= ' + f
      calcOut.classList.remove('dim')
      calcFresh = true

      const inp = $('ans')
      if (!inp) return
      inp.value = f
      submit()

      const top = $('card').getBoundingClientRect().top + window.pageYOffset - 8
      try {
        window.scrollTo({ top: top, behavior: 'smooth' })
      } catch (err) {
        window.scrollTo(0, top)
      }
    })

    /* ---------------- 难度 ---------------- */
    const LKEY = 'bhf_level_v1'
    const LV_NOTE = {
      0: '表里 1/2–1/20 三段 + 倍数：2/3、3/8、7/10…（范围固定）',
      1: '表内值一步变形：×10 / ×2 / 取补 / 近似整百',
      2: '全部题库，含需硬记的小数分母',
    }
    function updateLvNote() {
      $('lvNote').textContent = LV_NOTE[state.level]
    }

    /* 难度三档共用的界面同步：高亮当前档 + 简单档锁住「范围」 */
    function syncLevelUI() {
      ;[].forEach.call($('levelChips').querySelectorAll('.chip'), function (b) {
        b.classList.toggle('on', parseInt(b.dataset.l, 10) === state.level)
      })
      $('groupChips').classList.toggle('lock', state.level === 0)
      updateLvNote()
    }

    $('levelChips').addEventListener('click', function (e) {
      const b = e.target.closest('.chip')
      if (!b) return
      const lv = parseInt(b.dataset.l, 10)
      state.level = lv === 0 ? 0 : lv === 2 ? 2 : 1
      try {
        localStorage.setItem(LKEY, String(state.level))
      } catch (err) {}
      state.bag = []
      state.recent = []
      syncLevelUI()
      updateMeta()
      nextQuestion()
    })

    $('modeChips').addEventListener('click', function (e) {
      const b = e.target.closest('.chip')
      if (!b) return
      ;[].forEach.call(this.querySelectorAll('.chip'), function (x) {
        x.classList.remove('on')
      })
      b.classList.add('on')
      state.mode = b.dataset.m
      updateMeta()
      nextQuestion()
    })

    $('groupChips').addEventListener('click', function (e) {
      const b = e.target.closest('.chip')
      if (!b) return
      const g = b.dataset.g
      const onCount = Object.keys(state.groups).filter(function (k) {
        return state.groups[k]
      }).length
      if (state.groups[g] && onCount === 1) return
      state.groups[g] = !state.groups[g]
      b.classList.toggle('on', state.groups[g])
      updateMeta()
      nextQuestion()
    })

    document.addEventListener(
      'click',
      function (e) {
        if (e.target.closest('#tool, .modal, .hist, .foot, .actrow, .bhf-head, header, footer, a, button')) return
        const inp = $('ans')
        if (inp && !inp.disabled && document.activeElement !== inp) inp.focus()
      },
      sig,
    )

    $('btnClear').addEventListener('click', function () {
      state.history = []
      saveHistory()
      renderHistory()
    })

    /* ---------------- 顶部一行摘要 ---------------- */
    const MODE_LABEL = { fwd: '% → 分母', rev: '分母 → %', growth: '增长量', est: '反向估算', mixed: '混合' }
    const LV_LABEL = { 0: '简单', 1: '中等', 2: '困难' }
    const GROUP_LABEL = { basic: '2–10', mid: '11–15', high: '16–20', dec: '小数分母', big: '超 100%' }

    function updateMeta() {
      const keys = Object.keys(state.groups)
      const gs = keys.filter(function (k) {
        return state.groups[k]
      })
      $('sMeta').innerHTML =
        '<b>' + (MODE_LABEL[state.mode] || state.mode) + '</b> · ' +
        LV_LABEL[state.level] + ' · ' +
        (state.level === 0
          ? '1/2–1/20 + 倍数'
          : gs.length === keys.length
            ? '全部范围'
            : gs.map((k) => GROUP_LABEL[k]).join(' / '))
    }

    /* ---------------- 弹层 ---------------- */
    function openModal(id) {
      $(id).hidden = false
      document.body.classList.add('lock')
    }
    function closeModal(id) {
      $(id).hidden = true
      if ($('setModal').hidden && $('tblModal').hidden) document.body.classList.remove('lock')
    }

    $('btnSet').addEventListener('click', function () {
      openModal('setModal')
    })
    $('setClose').addEventListener('click', function () {
      closeModal('setModal')
    })
    $('btnTable').addEventListener('click', function () {
      openModal('tblModal')
    })
    $('btnTable2').addEventListener('click', function () {
      closeModal('setModal')
      openModal('tblModal')
    })
    $('tblClose').addEventListener('click', function () {
      closeModal('tblModal')
    })
    $('setModal').addEventListener('click', function (e) {
      if (e.target === this) closeModal('setModal')
    })
    $('tblModal').addEventListener('click', function (e) {
      if (e.target === this) closeModal('tblModal')
    })

    document.addEventListener(
      'keydown',
      function (e) {
        if (e.key !== 'Escape') return
        if (!$('tblModal').hidden) closeModal('tblModal')
        else if (!$('setModal').hidden) closeModal('setModal')
      },
      sig,
    )

    /* ---------------- 1/n 百分表 ---------------- */
    /* 简单模式的倍数直接用题库 MULTD，保证表和题目完全一致 */
    const TMODE_KEY = 'bhf_table_mode_v1'
    let tblMode = 'easy'
    try {
      if (localStorage.getItem(TMODE_KEY) === 'all') tblMode = 'all'
    } catch (e) {}

    function syncTblMode() {
      ;[].forEach.call($('tblMode').querySelectorAll('.chip'), function (b) {
        b.classList.toggle('on', b.dataset.tm === tblMode)
      })
    }

    function tgCell(label, pct) {
      return '<div class="tg"><b>' + label + '</b><span>' + pct + '%</span></div>'
    }

    function buildTable() {
      let html = ''

      if (tblMode === 'easy') {
        /* 简单模式：表里三段（基础 / 进阶 / 高阶）+ 基础表的倍数 */
        const easySecs = [
          { t: '基础　1/2 – 1/10', g: 'basic' },
          { t: '进阶　1/11 – 1/15', g: 'mid' },
          { t: '高阶　1/16 – 1/20', g: 'high' },
        ]
        easySecs.forEach(function (s) {
          const arr = DATA.filter((d) => d.g === s.g && d.real === undefined).sort((a, b) => a.n - b.n)
          html += '<div class="tsec">' + s.t + '</div><div class="tblgrid">'
          arr.forEach(function (d) {
            html += tgCell('1/' + d.n, d.pct)
          })
          html += '</div>'
        })

        html += '<div class="tsec">基础表的倍数</div><div class="tblgrid">'
        MULTD.forEach(function (m) {
          html += tgCell(m.k + '/' + m.n, m.pct)
        })
        html += '</div>'

        $('tblBody').innerHTML =
          html +
          '<div class="snote">简单模式只放基础表 1/2 – 1/20 和它们的倍数（2/3 = 66.7%、3/8 = 37.5%、7/9 = 77.8%……）。' +
          '这一页背熟再切「全部」，看小数分母和超 100%。</div>'
        return
      }

      const secs = [
        { t: '基础　1/1 – 1/10', g: 'basic' },
        { t: '进阶　1/11 – 1/15', g: 'mid' },
        { t: '高阶　1/16 – 1/20', g: 'high' },
        { t: '小数分母', g: 'dec' },
        { t: '超 100%（分母 < 1）', g: 'big' },
      ]
      secs.forEach(function (s) {
        const arr = DATA.filter((d) => d.g === s.g && d.real === undefined).sort((a, b) => a.n - b.n)
        if (!arr.length) return
        html += '<div class="tsec">' + s.t + '</div><div class="tblgrid">'
        arr.forEach(function (d) {
          html += tgCell('1/' + d.n, d.pct)
        })
        html += '</div>'
      })
      $('tblBody').innerHTML =
        html +
        '<div class="snote">表里的百分数是课件上的常用近似值；分母题按「表里的 n」或「100 ÷ 百分数」任一命中就算对。<br>' +
        '只想背最常用的那一小撮，点上面的「简单」。</div>'
    }

    $('tblMode').addEventListener('click', function (e) {
      const b = e.target.closest('.chip[data-tm]')
      if (!b) return
      tblMode = b.dataset.tm === 'all' ? 'all' : 'easy'
      try {
        localStorage.setItem(TMODE_KEY, tblMode)
      } catch (err) {}
      syncTblMode()
      buildTable()
    })

    /* =========================================================
       工具块：计算器 ⇄ 草稿纸（同一个块，一个按钮来回切）
       ========================================================= */
    const calcIn = $('calcIn'), calcOut = $('calcOut')
    let calcFresh = false

    function calcFormat(v) {
      if (!isFinite(v)) return '—'
      if (v !== 0 && (Math.abs(v) >= 1e9 || Math.abs(v) < 1e-4)) return v.toExponential(4)
      return String(Math.round(v * 1e6) / 1e6)
    }

    function calcEval(src) {
      const s = String(src)
        .replace(/[×xX*]/g, '*')
        .replace(/[÷/]/g, '/')
        .replace(/[−–—]/g, '-')
        .replace(/[,，\s]/g, '')
        .replace(/％/g, '%')
      if (!s) return NaN

      const out = [], ops = []
      const prec = { '+': 1, '-': 1, '*': 2, '/': 2 }
      let i = 0, prevIsValue = false

      while (i < s.length) {
        const c = s[i]
        if ((c >= '0' && c <= '9') || c === '.') {
          let j = i
          while (j < s.length && ((s[j] >= '0' && s[j] <= '9') || s[j] === '.')) j++
          const num = parseFloat(s.slice(i, j))
          if (!isFinite(num)) return NaN
          out.push(num)
          prevIsValue = true
          i = j
          continue
        }
        if (c === '%') {
          if (!prevIsValue) return NaN
          out.push(out.pop() / 100)
          i++
          continue
        }
        if (c === '(') {
          ops.push(c)
          prevIsValue = false
          i++
          continue
        }
        if (c === ')') {
          while (ops.length && ops[ops.length - 1] !== '(') out.push(ops.pop())
          if (!ops.length) return NaN
          ops.pop()
          prevIsValue = true
          i++
          continue
        }
        if (prec[c]) {
          if (c === '-' && !prevIsValue) out.push(0) // 一元负号
          else if (!prevIsValue) return NaN
          while (ops.length && prec[ops[ops.length - 1]] >= prec[c]) out.push(ops.pop())
          ops.push(c)
          prevIsValue = false
          i++
          continue
        }
        return NaN
      }
      while (ops.length) {
        const o = ops.pop()
        if (o === '(') return NaN
        out.push(o)
      }

      const st = []
      for (let k = 0; k < out.length; k++) {
        const t = out[k]
        if (typeof t === 'number') {
          st.push(t)
          continue
        }
        const b = st.pop(), a = st.pop()
        if (a === undefined || b === undefined) return NaN
        if (t === '+') st.push(a + b)
        else if (t === '-') st.push(a - b)
        else if (t === '*') st.push(a * b)
        else if (t === '/') {
          if (!b) return NaN
          st.push(a / b)
        } else return NaN
      }
      return st.length === 1 ? st[0] : NaN
    }

    function calcPreview() {
      const src = calcIn.value
      if (!src.trim()) {
        calcOut.textContent = '0'
        calcOut.classList.add('dim')
        return
      }
      const v = calcEval(src)
      if (!isFinite(v)) {
        calcOut.textContent = '…'
        calcOut.classList.add('dim')
        return
      }
      calcOut.textContent = '= ' + calcFormat(v)
      calcOut.classList.remove('dim')
    }

    function doCalcEq() {
      const src = calcIn.value.trim()
      if (!src) return
      const v = calcEval(src)
      if (!isFinite(v)) {
        calcOut.textContent = '算式看不懂'
        calcOut.classList.add('dim')
        return
      }
      const f = calcFormat(v)
      calcIn.value = f
      calcOut.textContent = '= ' + f
      calcOut.classList.remove('dim')
      calcFresh = true
    }

    calcIn.addEventListener('input', function () {
      calcFresh = false
      calcPreview()
    })
    calcIn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault()
        e.stopPropagation()
        doCalcEq()
      }
    })

    $('calcKeys').addEventListener('click', function (e) {
      const b = e.target.closest('button[data-k]')
      if (!b) return
      const k = b.dataset.k
      if (k === 'C') {
        calcIn.value = ''
        calcFresh = false
        calcPreview()
        return
      }
      if (k === 'back') {
        calcIn.value = calcIn.value.slice(0, -1)
        calcFresh = false
        calcPreview()
        return
      }
      if (k === '=') {
        doCalcEq()
        return
      }
      if (calcFresh && (k === '.' || (k >= '0' && k <= '9'))) calcIn.value = ''
      calcFresh = false
      calcIn.value += k
      calcPreview()
    })

    /* ---------------- 草稿纸 ---------------- */
    const pad = $('pad')
    const pctx = pad.getContext('2d')
    let penIdx = 1, penW = 2.5, erasing = false, drawing = false
    const undoStack = []

    /* 墨色跟着主题走：画的时候再取 CSS 变量，切主题后下笔就是新颜色 */
    function penColor() {
      try {
        return getComputedStyle(root).getPropertyValue('--pen' + penIdx).trim() || '#1c1c1f'
      } catch (e) {
        return '#1c1c1f'
      }
    }

    function resizePad() {
      const r = pad.getBoundingClientRect()
      if (!r.width) return
      const dpr = Math.min(window.devicePixelRatio || 1, 2.5)
      const prev = document.createElement('canvas')
      if (pad.width) {
        prev.width = pad.width
        prev.height = pad.height
        prev.getContext('2d').drawImage(pad, 0, 0)
      }
      pad.width = Math.max(1, Math.round(r.width * dpr))
      pad.height = Math.max(1, Math.round(r.height * dpr))
      pctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      pctx.lineCap = 'round'
      pctx.lineJoin = 'round'
      if (prev.width) {
        pctx.save()
        pctx.setTransform(1, 0, 0, 1, 0, 0)
        pctx.drawImage(prev, 0, 0, pad.width, pad.height)
        pctx.restore()
      }
    }

    function padSnapshot() {
      const c = document.createElement('canvas')
      c.width = pad.width
      c.height = pad.height
      c.getContext('2d').drawImage(pad, 0, 0)
      undoStack.push(c)
      if (undoStack.length > 15) undoStack.shift()
    }

    function padPos(e) {
      const r = pad.getBoundingClientRect()
      return { x: e.clientX - r.left, y: e.clientY - r.top }
    }

    pad.addEventListener('pointerdown', function (e) {
      e.preventDefault()
      if (!pad.width) resizePad()
      drawing = true
      padSnapshot()
      try {
        pad.setPointerCapture(e.pointerId)
      } catch (err) {}
      const p = padPos(e)
      pctx.globalCompositeOperation = erasing ? 'destination-out' : 'source-over'
      pctx.strokeStyle = penColor()
      pctx.lineWidth = erasing ? penW * 5 : penW
      pctx.beginPath()
      pctx.moveTo(p.x, p.y)
      pctx.lineTo(p.x + 0.1, p.y + 0.1)
      pctx.stroke()
    })

    pad.addEventListener('pointermove', function (e) {
      if (!drawing) return
      e.preventDefault()
      const p = padPos(e)
      pctx.lineTo(p.x, p.y)
      pctx.stroke()
    })

    function padEnd() {
      if (!drawing) return
      drawing = false
      pctx.globalCompositeOperation = 'source-over'
    }
    pad.addEventListener('pointerup', padEnd)
    pad.addEventListener('pointercancel', padEnd)
    pad.addEventListener('pointerleave', padEnd)

    $('padPen').addEventListener('click', function () {
      erasing = false
      this.classList.add('on')
      $('padErase').classList.remove('on')
    })
    $('padErase').addEventListener('click', function () {
      erasing = true
      this.classList.add('on')
      $('padPen').classList.remove('on')
    })

    ;[].forEach.call(document.querySelectorAll('#panePad .pdot'), function (b) {
      b.addEventListener('click', function () {
        penIdx = parseInt(b.dataset.pen, 10) || 1
        erasing = false
        ;[].forEach.call(document.querySelectorAll('#panePad .pdot'), function (x) {
          x.classList.toggle('on', x === b)
        })
        $('padErase').classList.remove('on')
        $('padPen').classList.add('on')
      })
    })

    ;[].forEach.call(document.querySelectorAll('#panePad .pbtn[data-w]'), function (b) {
      b.addEventListener('click', function () {
        penW = parseFloat(b.dataset.w) || 2.5
        ;[].forEach.call(document.querySelectorAll('#panePad .pbtn[data-w]'), function (x) {
          x.classList.toggle('on', x === b)
        })
      })
    })

    $('padUndo').addEventListener('click', function () {
      const c = undoStack.pop()
      if (!c) return
      pctx.save()
      pctx.setTransform(1, 0, 0, 1, 0, 0)
      pctx.clearRect(0, 0, pad.width, pad.height)
      pctx.drawImage(c, 0, 0)
      pctx.restore()
    })

    $('padClear').addEventListener('click', function () {
      padSnapshot()
      pctx.save()
      pctx.setTransform(1, 0, 0, 1, 0, 0)
      pctx.clearRect(0, 0, pad.width, pad.height)
      pctx.restore()
    })

    window.addEventListener(
      'resize',
      function () {
        if (!$('panePad').hidden) resizePad()
      },
      sig,
    )
    window.addEventListener(
      'orientationchange',
      function () {
        setTimeout(function () {
          if (!$('panePad').hidden) resizePad()
        }, 250)
      },
      sig,
    )

    /* ---------------- 工具块开合 / 切换 ---------------- */
    let toolTab = 'calc'

    function setTool(t) {
      toolTab = t
      $('paneCalc').hidden = t !== 'calc'
      $('panePad').hidden = t !== 'pad'
      ;[].forEach.call(document.querySelectorAll('#tool .tt[data-t]'), function (b) {
        b.classList.toggle('on', b.dataset.t === t)
      })
      $('btnTool').textContent = t === 'calc' ? '🧮 计算器 ⇄' : '✏️ 草稿纸 ⇄'
      if (t === 'pad') setTimeout(resizePad, 0)
    }

    function openTool(t) {
      $('tool').hidden = false
      $('btnTool').classList.add('on')
      setTool(t || toolTab)
    }

    $('btnTool').addEventListener('click', function () {
      if ($('tool').hidden) {
        openTool(toolTab)
      } else {
        setTool(toolTab === 'calc' ? 'pad' : 'calc')
      }
    })

    ;[].forEach.call(document.querySelectorAll('#tool .tt[data-t]'), function (b) {
      b.addEventListener('click', function () {
        setTool(b.dataset.t)
      })
    })

    $('btnToolClose').addEventListener('click', function () {
      $('tool').hidden = true
      $('btnTool').classList.remove('on')
    })

    $('btnCalcQuick').addEventListener('click', function () {
      closeModal('setModal')
      openTool('calc')
    })

    /* ---------------- 全屏 / 沉浸 ---------------- */
    const fsBtn = $('btnFull')

    function fsElement() {
      return (
        document.fullscreenElement ||
        document.webkitFullscreenElement ||
        document.msFullscreenElement ||
        null
      )
    }
    function setFsUI(on) {
      document.body.classList.toggle('bhf-fs', !!on)
      fsBtn.textContent = on ? '退出' : '全屏'
      fsBtn.classList.toggle('on', !!on)
    }

    fsBtn.addEventListener('click', function () {
      if (fsElement()) {
        const ex = document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen
        if (ex) ex.call(document)
        return
      }
      const el = document.documentElement
      const req = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen
      if (req) {
        try {
          const p = req.call(el)
          if (p && p.then) {
            p.then(function () {
              setFsUI(true)
            }).catch(function () {
              setFsUI(!document.body.classList.contains('bhf-fs'))
            })
          } else setFsUI(true)
        } catch (err) {
          setFsUI(!document.body.classList.contains('bhf-fs'))
        }
      } else {
        // iPhone Safari 没有元素全屏：退化成沉浸模式
        setFsUI(!document.body.classList.contains('bhf-fs'))
      }
    })

    document.addEventListener('fullscreenchange', function () {
      setFsUI(!!fsElement())
    }, sig)
    document.addEventListener('webkitfullscreenchange', function () {
      setFsUI(!!fsElement())
    }, sig)

    /* ---------------- 点历史记录重做 ---------------- */
    $('histList').addEventListener('click', function (e) {
      const row = e.target.closest('.hrow.canredo')
      if (!row) return
      replayHistory(parseInt(row.dataset.i, 10))
    })

    try {
      const savedLv = localStorage.getItem(LKEY)
      if (savedLv === '0') state.level = 0
      else if (savedLv === '2') state.level = 2
    } catch (e) {}
    syncLevelUI()

    state.history = loadHistory()
    renderHistory()
    syncTblMode()
    buildTable()
    setTool('calc')
    updateMeta()
    nextQuestion()
    updateStats()
    }

    /*
     * ClientRouter 换页时，脚本可能比新的 <body> 先到；这时 #bhfRoot 已存在
     * 但题目节点还没有，直接初始化会拿到 null。等节点齐了再启动一次。
     */
    function boot(tries) {
      const root = document.getElementById('bhfRoot')
      if (!root || root.dataset.ready === '1') return
      if (!document.getElementById('card') || !document.getElementById('numRow')) {
        if ((tries || 0) < 200) setTimeout(() => boot((tries || 0) + 1), 20)
        return
      }
      start(root)
    }

    /*
     * ClientRouter 同一个脚本只会执行一次，第二次回到本页不会重跑；
     * 所以挂一个持久的 page-load 钩子，每次换页进来都重新启动。
     */
    const w = window as unknown as { __bhfBootHooked?: boolean }
    if (!w.__bhfBootHooked) {
      w.__bhfBootHooked = true
      document.addEventListener('astro:page-load', () => boot(0))
    }

    boot(0)
  })()
</script>
