      /* --- 倍数组② --- */
      { n: 3, pct: 33.3, g: 'basic', tip: '33.3%，比真正的 1/3 小一点点' },
      { n: 6, pct: 16.7, g: 'basic', tip: '33.3 砍一半 ≈ 16.7' },
      /* --- 中间 --- */
      { n: 5, pct: 20, g: 'basic', tip: '÷5 = ×20%，除 5 乘 2' },
