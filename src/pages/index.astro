---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'

const posts = (await getCollection('posts', ({ data }) => data.public)).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
)
const latest = posts.slice(0, 5)
---

<Base title="妲零">
  <section class="wrap hero">
    <h1>妲零</h1>
    <p>
      我的个人博客。在这里记录我正在做的事、学到的东西，还有一些还没想清楚、
      但值得写下来的念头。更新不快，但都自己写。
    </p>
    <div class="actions">
      <a class="btn primary" href="/posts/">读文章</a>
      <a class="btn" href="/skills/">看工具</a>
    </div>
  </section>

  <section class="wrap">
    <h2>最新文章</h2>
    {latest.length === 0 ? (
      <p class="empty">还没有公开文章。</p>
    ) : (
      <ul class="post-list">
        {latest.map((post) => (
          <li class="post-item">
            <h2>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </h2>
            <div class="post-meta">
              <span>{post.data.date}</span>
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            {post.data.description ? <p class="muted">{post.data.description}</p> : null}
          </li>
        ))}
      </ul>
    )}
    {posts.length > latest.length ? (
      <p>
        <a href="/posts/">查看全部 {posts.length} 篇 →</a>
      </p>
    ) : null}
  </section>

  <section class="wrap">
    <h2>关于这里</h2>
    <p class="muted">
      这里是妲零的自留地。除了文章，我也会把自己在用的工具和脚本整理出来放在
      <a href="/skills/">工具</a> 页，方便你直接用。
    </p>
  </section>
</Base>
