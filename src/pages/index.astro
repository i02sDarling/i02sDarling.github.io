---
import Base from '../layouts/Base.astro'

// 两个站点。GSP 是演示环境（暂时只有 http），换域名后改这里 + 页面里的内联脚本
const GSP_URL = 'http://110.42.224.84:8080/'

const sites = [
  {
    target: 'personal',
    href: '/home/',
    title: '个人主页',
    desc: '妲零的博客：文章、在用的工具，以及还没想清楚的念头。',
    meta: 'i02sdarling.github.io',
  },
  {
    target: 'gsp',
    href: GSP_URL,
    title: 'GSP 合规演示',
    desc: '给客户看的合规演示系统，进去需要账号，找我要。',
    meta: '110.42.224.84:8080',
  },
]
---

<Base title="选择站点">
  <Fragment slot="head">
    <script is:inline>
      // 记住上次的选择（30 分钟），下次打开直接进对应站点；?pick=1 强制显示本页
      ;(() => {
        try {
          if (new URLSearchParams(location.search).get('pick') === '1') return
          const saved = JSON.parse(localStorage.getItem('entry-choice') || 'null')
          if (!saved || !(saved.expireAt > Date.now())) return
          location.replace(saved.target === 'gsp' ? 'http://110.42.224.84:8080/' : '/home/')
        } catch {}
      })()
    </script>
  </Fragment>

  <section class="wrap hero">
    <h1>要去哪个站点？</h1>
    <p>两个地方：我的个人主页，和给客户看的 GSP 合规演示。</p>
  </section>

  <section class="wrap choose">
    {
      sites.map((site) => (
        <a class="choose-item" href={site.href} data-target={site.target}>
          <span class="choose-head">
            <span class="choose-title">{site.title}</span>
            <span class="choose-arrow" aria-hidden="true">
              →
            </span>
          </span>
          <span class="choose-desc">{site.desc}</span>
          <span class="choose-meta">{site.meta}</span>
        </a>
      ))
    }
  </section>

  <section class="wrap choose-note">
    <p class="muted">选过一次会记住 30 分钟，下次打开直接进；想重新选，点页脚的「切换站点」。</p>
    <p class="muted">
      GSP 演示站目前只有 http，从 https 跳过去时地址栏会提示「不安全」，这是正常的。
    </p>
  </section>
</Base>

<script>
  // 点哪个就记住哪个（跳转仍走 href，这里只负责记）
  const links = document.querySelectorAll<HTMLAnchorElement>('.choose-item[data-target]')
  for (const link of links) {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem(
          'entry-choice',
          JSON.stringify({ target: link.dataset.target, expireAt: Date.now() + 30 * 60 * 1000 }),
        )
      } catch {}
    })
  }
</script>
