---
import { getCollection, render } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import { formatPostDate, readingMinutes } from '../../lib/posts.ts'
import { postSlug, resolvePostData, stripMetadataBlock } from '../../lib/metadata.ts'

export const getStaticPaths: GetStaticPaths = async () => {
  // 本地 dev 连草稿一起生成页面，线上只构建公开文章
  // public / date / slug 都以正文开头的 metadata 块为准，front-matter 只兜底
  const all = await getCollection('posts')
  const entries = all
    .map((post) => ({ post, meta: resolvePostData(post), slug: postSlug(post) }))
    .filter((entry) => !entry.meta.deleted && (entry.meta.public || import.meta.env.DEV))
    .sort((a, b) => String(b.meta.date).localeCompare(String(a.meta.date)))

  return entries.map((entry, index) => ({
    params: { id: entry.slug },
    // 上一篇 = 更新的那篇，下一篇 = 更旧的那篇
    props: {
      post: entry.post,
      meta: entry.meta,
      prev: entries[index - 1] ?? null,
      next: entries[index + 1] ?? null,
    },
  }))
}

const { post, meta, prev, next } = Astro.props
const { Content, headings } = await render(post)

// 大纲收 2–4 级标题，靠 .toc-item.d2/d3/d4 的缩进表现层级；
// 只在 h4 特别碎（超过 30 条）时丢掉 h4，免得整份大纲长到没法扫
const detailed = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4)
const tocItems = detailed.filter((heading) => heading.depth <= 3).length >= 30
  ? detailed.filter((heading) => heading.depth <= 3)
  : detailed
const lastEdited = meta.updated || meta.date
---

<Base title={meta.title} description={meta.description}>
  {
    tocItems.length > 1 ? (
      <nav class="toc" data-toc aria-label="文章大纲">
        <button class="toc-anchor" type="button" data-toc-toggle aria-expanded="false" title="文章大纲（点一下固定）">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h11M4 17h16" />
          </svg>
          <span class="sr-only">文章大纲</span>
        </button>
        <ol class="toc-list">
          {tocItems.map((heading) => (
            <li class={`toc-item d${heading.depth}`}>
              <a href={`#${heading.slug}`} data-toc-link>
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : null
  }

  <article class="wrap post-page">
    <header class="post-header">
      <h1>{meta.title}</h1>
      <div class="post-meta">
        {meta.group ? <span class="tag post-group">{meta.group}</span> : null}
        <span>{formatPostDate(meta.date, true)}</span>
        <span aria-hidden="true">·</span>
        <span>{readingMinutes(stripMetadataBlock(post.body))} min</span>
        {!meta.public ? <span class="tag draft">草稿 · 仅本地可见</span> : null}
        {meta.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      {meta.description ? <p class="muted">{meta.description}</p> : null}
    </header>

    <div class="article">
      <Content />
    </div>

    <hr />

    <div class="post-nav">
      <span class="post-edited">最后编辑于 {lastEdited}</span>
    </div>

    {
      prev || next ? (
        <nav class="post-adjacent" aria-label="相邻文章">
          {prev ? (
            <a class="adjacent-item" href={`/posts/${prev.slug}/`}>
              <span class="adjacent-label">← 上一篇</span>
              <span class="adjacent-title">{prev.meta.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="adjacent-item adjacent-next" href={`/posts/${next.slug}/`}>
              <span class="adjacent-label">下一篇 →</span>
              <span class="adjacent-title">{next.meta.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      ) : null
    }

    <div class="post-terminal" aria-label="快捷导航">
      <p>
        <span class="term-prompt">&gt;</span>
        <a href="/">cd ~</a>
        <span class="term-note">回首页</span>
      </p>
      <p>
        <span class="term-prompt">&gt;</span>
        <a href="/posts/">cd ..</a>
        <span class="term-note">返回文章列表</span>
      </p>
    </div>
  </article>
</Base>
